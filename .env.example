# Copy to a private .env outside releases; chmod 600. Use hex for database password.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_ORIGIN=http://localhost:8086
COOKIE_SECURE=false
RELEASE_TAG=latest
